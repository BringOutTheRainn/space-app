{
  "name": "stardust-empire",
  "version": "1.0.0",
  "private": true,
  "description": "A space-themed incremental clicker for phones.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test tests/*.test.js && node tools/i18n-keys.mjs --list",
    "serve": "npx http-server www -p 8080 -c-1",
    "sim": "npm run build && node tools/simulate.mjs",
    "screens": "npm run build && node tools/screens.mjs screens",
    "store-shots": "npm run build && node tools/store-shots.mjs store",
    "icons": "node tools/make_icons.mjs",
    "android": "npm run build && bash tools/android.sh",
    "i18n": "npm run build && node tools/i18n-keys.mjs --list",
    "preflight": "node tools/preflight.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "cordova-plugin-purchase": "^13.10.0"
  }
}
